# Gemini API Key (Google AI Studio)
# GEMINI_API_KEY=your_gemini_api_key_here

GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
# global이 아닌 리전은 Gemini 요금이 10% 더 비쌉니다.
GOOGLE_CLOUD_LOCATION=global
# 첫 번째로 시도할 모델. GEMINI_MODEL도 인식합니다.
GEMINI_SHORTFORM_MODEL=gemini-3.8-flash
# 실패 시 차례로 시도할 모델 (쉼표 구분)
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_TIMEOUT_SEC=600
GEMINI_ATTEMPTS_PER_MODEL=2
GEMINI_RETRY_DELAY_SEC=3

# Google / YouTube OAuth 2.0 (크리에이터 로그인 및 YouTube Data·Analytics API)
# Google Cloud Console > APIs & Services > Credentials에서 OAuth 2.0 웹 클라이언트 생성 후
# 승인된 리디렉션 URI에 http://localhost:3000/api/shortform/auth/callback (로컬 개발)
# 또는 <Cloud Run URL>/api/shortform/auth/callback 을 추가하세요.
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret

# 서버
BACKEND_PORT=5000
STUDIO_HEARTBEAT_SEC=5
STUDIO_WORKDIR=/tmp/ytcreator-studio
STUDIO_RETENTION_HOURS=24
STUDIO_SUBPROCESS_TIMEOUT_SEC=900
# 업로드 영상·자막·렌더 결과·OAuth 세션을 보관할 Cloud Storage 버킷.
# 비워 두면 지금처럼 STUDIO_WORKDIR(로컬 디스크)에만 저장합니다.
# Cloud Run에서는 terraform/이 만든 버킷 이름을 넣어 줍니다.
# STUDIO_GCS_BUCKET=

# 업로드 원본 무음 측정 (ffmpeg silencedetect)
STUDIO_SILENCE_NOISE_DB=-35
STUDIO_SILENCE_MIN_SEC=0.1

# 영상 파일로 분석할 때 Gemini에 보내는 저해상도 사본
STUDIO_ANALYSIS_PROXY_HEIGHT=360
STUDIO_ANALYSIS_PROXY_FPS=10
# 사본을 요청에 직접 담는 최대 크기 (Vertex 인라인 한도 100MB)
STUDIO_MAX_INLINE_VIDEO_MB=100
# 첫 분석 때 영상을 Gemini Context Cache에 올려 두는 시간(초).
# 이 시간 안의 "화면 재탐색" 재분석은 캐시된 영상을 다시 씁니다.
STUDIO_CONTEXT_CACHE_TTL_SEC=3600

# 순수 로컬 영상(또는 YouTube 공식 자막이 없는 영상) 음성 전사용
# Google Cloud Speech-to-Text V2 설정 (chirp_3, us 멀티리전)
STUDIO_SPEECH_LOCATION=us
STUDIO_SPEECH_MODEL=chirp_3
STUDIO_SPEECH_LANGUAGES=auto

# 렌더
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
